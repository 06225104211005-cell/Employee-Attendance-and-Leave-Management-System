
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StaffDesk | HR Management</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

body {
    background: #f4f6fb;
    color: #252b42;
}

.layout {
    display: flex;
    min-height: 100vh;
}

/* Sidebar */
.sidebar {
    width: 245px;
    background: #171c35;
    color: white;
    padding: 25px 17px;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    margin-bottom: 8px;
}

.logo span {
    color: #8d8aff;
}

.tagline {
    font-size: 12px;
    color: #a5abc4;
    margin-bottom: 35px;
}

.nav-title {
    font-size: 11px;
    color: #858da9;
    margin: 22px 12px 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.nav-link {
    padding: 13px 14px;
    margin-bottom: 7px;
    border-radius: 9px;
    cursor: pointer;
    color: #c4c9dd;
    display: flex;
    gap: 12px;
    transition: .2s;
    font-size: 14px;
}

.nav-link:hover,
.nav-link.active {
    background: #343b68;
    color: white;
}

.admin {
    border-top: 1px solid #373d5c;
    padding-top: 20px;
    margin-top: 35px;
    display: flex;
    gap: 10px;
    align-items: center;
}

.admin img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
}

.admin small {
    color: #a5abc4;
}

/* Main */
.main {
    margin-left: 245px;
    width: calc(100% - 245px);
    padding: 28px 35px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    gap: 15px;
}

.topbar h2 {
    font-size: 24px;
}

.topbar p {
    color: #8990a5;
    font-size: 13px;
    margin-top: 5px;
}

.admin-label {
    background: white;
    padding: 11px 17px;
    border-radius: 10px;
    box-shadow: 0 3px 15px #1c24500a;
    font-size: 13px;
    font-weight: 600;
}

/* Sections */
.section {
    display: none;
}

.section.active {
    display: block;
}

.section-heading {
    margin-bottom: 20px;
}

.section-heading h2 {
    font-size: 21px;
}

.section-heading p {
    color: #8b91a4;
    font-size: 13px;
    margin-top: 6px;
}

/* Dashboard Cards */
.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card {
    background: white;
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 4px 20px #1c245008;
}

.stat-card p {
    color: #8990a5;
    font-size: 13px;
}

.stat-card h2 {
    font-size: 29px;
    margin: 13px 0 5px;
}

.stat-card small {
    color: #8990a5;
    font-size: 11px;
}

.stat-icon {
    font-size: 23px;
    float: right;
    background: #efefff;
    padding: 9px;
    border-radius: 10px;
}

/* Content Cards */
.card {
    background: white;
    border-radius: 14px;
    padding: 23px;
    box-shadow: 0 4px 20px #1c245008;
    margin-bottom: 22px;
}

.card h3 {
    font-size: 16px;
    margin-bottom: 18px;
}

.grid-two {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 20px;
}

/* Table */
.table-wrap {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 650px;
}

th {
    text-align: left;
    padding: 14px 12px;
    color: #858ba0;
    background: #f8f9fc;
    font-size: 12px;
    font-weight: 600;
}

td {
    padding: 14px 12px;
    border-bottom: 1px solid #f0f1f5;
    font-size: 13px;
}

.employee-cell {
    display: flex;
    align-items: center;
    gap: 10px;
}

.employee-cell img {
    width: 39px;
    height: 39px;
    border-radius: 50%;
    object-fit: cover;
}

.employee-cell small {
    display: block;
    color: #969bad;
    margin-top: 4px;
}

.status {
    padding: 6px 11px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    display: inline-block;
}

.present, .approved {
    background: #e5f8ee;
    color: #15965a;
}

.absent, .rejected {
    background: #ffeded;
    color: #dc5353;
}

.late {
    background: #fff3df;
    color: #d28b20;
}

.pending {
    background: #fff2dc;
    color: #c78317;
}

/* Buttons */
.btn {
    border: none;
    padding: 11px 17px;
    border-radius: 8px;
    background: #655ee8;
    color: white;
    cursor: pointer;
    font-weight: 600;
    font-size: 12px;
}

.btn:hover {
    background: #5149d2;
}

.btn-light {
    background: #efefff;
    color: #655ee8;
}

.btn-danger {
    background: #ffecec;
    color: #d34d4d;
}

.btn-success {
    background: #e5f8ee;
    color: #15965a;
}

.action-buttons {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

/* Inputs */
input, select, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #e4e6ef;
    border-radius: 8px;
    outline: none;
    margin-top: 7px;
    background: white;
    color: #252b42;
}

input:focus, select:focus, textarea:focus {
    border-color: #655ee8;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    font-size: 12px;
    font-weight: 600;
}

.search-row {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.search-row input {
    max-width: 350px;
    margin: 0;
}

.search-row select {
    max-width: 180px;
    margin: 0;
}

/* Progress */
.progress {
    background: #eeeef5;
    height: 8px;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 10px;
}

.progress div {
    height: 100%;
    background: #7169ed;
    border-radius: 10px;
}

/* Charts */
.bar-list {
    display: flex;
    flex-direction: column;
    gap: 17px;
}

.bar-item {
    font-size: 12px;
}

.bar-line {
    background: #eeeef5;
    height: 9px;
    border-radius: 10px;
    margin-top: 8px;
    overflow: hidden;
}

.bar-line div {
    height: 100%;
    background: #7169ed;
}

/* Modal */
.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: #15182b99;
    z-index: 100;
    justify-content: center;
    align-items: center;
    padding: 15px;
}

.modal.show {
    display: flex;
}

.modal-box {
    background: white;
    padding: 25px;
    border-radius: 15px;
    width: 100%;
    max-width: 550px;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
}

.close {
    border: none;
    background: none;
    font-size: 24px;
    cursor: pointer;
}

/* Empty */
.empty {
    text-align: center;
    color: #999;
    padding: 30px;
}

/* Responsive */
@media(max-width:1000px) {
    .stats {
        grid-template-columns: repeat(2, 1fr);
    }
    .grid-two {
        grid-template-columns: 1fr;
    }
}

@media(max-width:700px) {
    .sidebar {
        width: 65px;
        padding: 20px 8px;
    }
    .logo {
        font-size: 12px;
        overflow: hidden;
    }
    .tagline, .nav-title, .nav-link span,
    .admin div {
        display: none;
    }
    .nav-link {
        justify-content: center;
        font-size: 19px;
        padding: 13px 5px;
    }
    .admin {
        justify-content: center;
    }
    .admin img {
        width: 35px;
        height: 35px;
    }
    .main {
        margin-left: 65px;
        width: calc(100% - 65px);
        padding: 20px 12px;
    }
    .stats {
        gap: 10px;
    }
    .stat-card {
        padding: 14px;
    }
    .stat-card h2 {
        font-size: 22px;
    }
    .topbar h2 {
        font-size: 19px;
    }
    .form-grid {
        grid-template-columns: 1fr;
    }
    .search-row {
        flex-wrap: wrap;
    }
}
</style>
</head>

<body>

<div class="layout">

<!-- SIDEBAR -->
<aside class="sidebar">

    <div class="logo">Staff<span>Desk.</span></div>
    <div class="tagline">Smart HR Management</div>

    <div class="nav-title">Main Menu</div>

    <div class="nav-link active" onclick="showSection('dashboard',this)">
        <span>▦</span><span>Dashboard</span>
    </div>

    <div class="nav-link" onclick="showSection('employees',this)">
        <span>♙</span><span>Employees</span>
    </div>

    <div class="nav-title">Management</div>

    <div class="nav-link" onclick="showSection('attendance',this)">
        <span>◷</span><span>Attendance</span>
    </div>

    <div class="nav-link" onclick="showSection('leaves',this)">
        <span>▤</span><span>Leave Requests</span>
    </div>

    <div class="nav-title">Analytics</div>

    <div class="nav-link" onclick="showSection('reports',this)">
        <span>▥</span><span>Monthly Reports</span>
    </div>

    <div class="admin">
        <img src="https://i.pravatar.cc/100?img=12"
             alt="Admin Shahinur">
        <div>
            <b>Shahinur</b><br>
            <small>Administrator</small>
        </div>
    </div>

</aside>

<!-- MAIN CONTENT -->
<main class="main">

<header class="topbar">
    <div>
        <h2 id="pageTitle">Dashboard Overview</h2>
        <p id="todayDate"></p>
    </div>

    <div class="admin-label">
        👤 Admin: Shahinur
    </div>
</header>

<!-- DASHBOARD -->
<section id="dashboard" class="section active">

    <div class="section-heading">
        <h2>Welcome back, Shahinur! 👋</h2>
        <p>Here's what's happening with your team today.</p>
    </div>

    <div class="stats">

        <div class="stat-card">
            <span class="stat-icon">👥</span>
            <p>Total Employees</p>
            <h2 id="totalEmployees">12</h2>
            <small>Registered employees</small>
        </div>

        <div class="stat-card">
            <span class="stat-icon">✅</span>
            <p>Present Today</p>
            <h2 id="presentCount">0</h2>
            <small>Marked as present</small>
        </div>

        <div class="stat-card">
            <span class="stat-icon">❌</span>
            <p>Absent Today</p>
            <h2 id="absentCount">0</h2>
            <small>Marked as absent</small>
        </div>

        <div class="stat-card">
            <span class="stat-icon">📋</span>
            <p>Pending Leaves</p>
            <h2 id="pendingCount">0</h2>
            <small>Waiting for approval</small>
        </div>

    </div>

    <div class="grid-two">

        <div class="card">
            <h3>Recent Attendance</h3>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Check In</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="recentAttendance"></tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <h3>Attendance Overview</h3>

            <div class="bar-list">
                <div class="bar-item">
                    <span>Present</span>
                    <div class="bar-line">
                        <div id="presentBar" style="width:0%"></div>
                    </div>
                </div>

                <div class="bar-item">
                    <span>Absent</span>
                    <div class="bar-line">
                        <div id="absentBar" style="width:0%"></div>
                    </div>
                </div>

                <div class="bar-item">
                    <span>Late</span>
                    <div class="bar-line">
                        <div id="lateBar" style="width:0%"></div>
                    </div>
                </div>
            </div>

            <p style="font-size:12px;color:#999;margin-top:25px">
                Today's attendance statistics.
            </p>
        </div>

    </div>

    <div class="card">
        <h3>Quick Actions</h3>

        <div class="action-buttons">
            <button class="btn" onclick="showSection('employees')">
                + Add Employee
            </button>

            <button class="btn btn-light"
                    onclick="showSection('attendance')">
                Mark Attendance
            </button>

            <button class="btn btn-light"
                    onclick="showSection('leaves')">
                View Leave Requests
            </button>

            <button class="btn btn-light"
                    onclick="showSection('reports')">
                View Reports
            </button>
        </div>
    </div>

</section>

<!-- EMPLOYEES -->
<section id="employees" class="section">

    <div class="section-heading">
        <h2>Employee Directory</h2>
        <p>Manage your team members and their information.</p>
    </div>

    <div class="card">

        <div class="search-row">
            <input type="text" id="employeeSearch"
                   placeholder="Search employee..."
                   oninput="renderEmployees()">

            <button class="btn" onclick="openEmployeeModal()">
                + Add Employee
            </button>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Employee ID</th>
                        <th>Department</th>
                        <th>Position</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="employeeTable"></tbody>
            </table>
        </div>

    </div>
</section>

<!-- ATTENDANCE -->
<section id="attendance" class="section">

    <div class="section-heading">
        <h2>Attendance Management</h2>
        <p>Record daily attendance and working hours.</p>
    </div>

    <div class="card">

        <div class="form-grid">

            <div class="form-group">
                <label>Select Employee</label>
                <select id="attEmployee"></select>
            </div>

            <div class="form-group">
                <label>Attendance Date</label>
                <input type="date" id="attDate">
            </div>

            <div class="form-group">
                <label>Check In</label>
                <input type="time" id="checkIn">
            </div>

            <div class="form-group">
                <label>Check Out</label>
                <input type="time" id="checkOut">
            </div>

            <div class="form-group">
                <label>Attendance Status</label>
                <select id="attStatus">
                    <option value="Present">Present</option>
                    <option value="Late">Late</option>
                    <option value="Absent">Absent</option>
                </select>
            </div>

        </div>

        <button class="btn" onclick="saveAttendance()">
            Save Attendance
        </button>

    </div>

    <div class="card">
        <h3>Attendance History</h3>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Date</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody id="attendanceTable"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- LEAVES -->
<section id="leaves" class="section">

    <div class="section-heading">
        <h2>Leave Management</h2>
        <p>Review applications and manage employee leave requests.</p>
    </div>

    <div class="card">

        <h3>Submit Leave Application</h3>

        <div class="form-grid">

            <div class="form-group">
                <label>Employee</label>
                <select id="leaveEmployee"></select>
            </div>

            <div class="form-group">
                <label>Leave Type</label>
                <select id="leaveType">
                    <option>Casual Leave</option>
                    <option>Sick Leave</option>
                    <option>Annual Leave</option>
                    <option>Emergency Leave</option>
                </select>
            </div>

            <div class="form-group">
                <label>Start Date</label>
                <input type="date" id="leaveStart">
            </div>

            <div class="form-group">
                <label>End Date</label>
                <input type="date" id="leaveEnd">
            </div>

        </div>

        <div class="form-group">
            <label>Reason for Leave</label>
            <textarea id="leaveReason"
                      rows="3"
                      placeholder="Write a short reason..."></textarea>
        </div>

        <button class="btn" onclick="submitLeave()">
            Submit Application
        </button>

    </div>

    <div class="card">

        <h3>Leave Applications</h3>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Dates</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="leaveTable"></tbody>
            </table>
        </div>

    </div>

</section>

<!-- REPORTS -->
<section id="reports" class="section">

    <div class="section-heading">
        <h2>Monthly Attendance Reports</h2>
        <p>Track employee attendance and monthly performance.</p>
    </div>

    <div class="card">

        <div class="search-row">
            <input type="month" id="reportMonth">

            <button class="btn" onclick="renderReports()">
                Generate Report
            </button>

            <button class="btn btn-light" onclick="downloadCSV()">
                ↓ Export CSV
            </button>
        </div>

        <div class="stats">

            <div class="stat-card">
                <p>Total Records</p>
                <h2 id="reportTotal">0</h2>
            </div>

            <div class="stat-card">
                <p>Present</p>
                <h2 id="reportPresent">0</h2>
            </div>

            <div class="stat-card">
                <p>Absent</p>
                <h2 id="reportAbsent">0</h2>
            </div>

            <div class="stat-card">
                <p>Late</p>
                <h2 id="reportLate">0</h2>
            </div>

        </div>

        <h3 style="margin-bottom:18px">Employee-wise Summary</h3>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Present</th>
                        <th>Absent</th>
                        <th>Late</th>
                        <th>Attendance Rate</th>
                    </tr>
                </thead>

                <tbody id="reportTable"></tbody>
            </table>
        </div>

    </div>

</section>

</main>
</div>

<!-- EMPLOYEE MODAL -->
<div class="modal" id="employeeModal">

    <div class="modal-box">

        <div class="modal-header">
            <h3 id="modalTitle">Add New Employee</h3>
            <button class="close"
                    onclick="closeEmployeeModal()">×</button>
        </div>

        <input type="hidden" id="editEmployeeId">

        <div class="form-group">
            <label>Employee Name</label>
            <input id="empName" placeholder="Full name">
        </div>

        <div class="form-grid">

            <div class="form-group">
                <label>Department</label>
                <select id="empDepartment">
                    <option>Human Resources</option>
                    <option>Finance</option>
                    <option>Marketing</option>
                    <option>IT Department</option>
                    <option>Administration</option>
                    <option>Operations</option>
                </select>
            </div>

            <div class="form-group">
                <label>Position</label>
                <input id="empPosition"
                       placeholder="e.g. Executive">
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input id="empPhone"
                       placeholder="01XXXXXXXXX">
            </div>

            <div class="form-group">
                <label>Profile Photo URL</label>
                <input id="empPhoto"
                       placeholder="https://...">
            </div>

        </div>

        <button class="btn" onclick="saveEmployee()">
            Save Employee
        </button>

    </div>
</div>

