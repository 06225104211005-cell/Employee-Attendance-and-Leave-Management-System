function loadData(key, fallback) {
    try {
        const saved = localStorage.getItem(key);
        return saved ? JSON.parse(saved) : fallback;
    } catch (error) {
        return fallback;
    }
}

let employees = loadData("staffdesk_employees", defaultEmployees);
let attendance = loadData("staffdesk_attendance", []);
let leaves = loadData("staffdesk_leaves", []);

function saveData() {
    localStorage.setItem("staffdesk_employees",
        JSON.stringify(employees));

    localStorage.setItem("staffdesk_attendance",
        JSON.stringify(attendance));

    localStorage.setItem("staffdesk_leaves",
        JSON.stringify(leaves));
}

/* ==========================
   COMMON FUNCTIONS
========================== */

const today = new Date().toLocaleDateString("en-CA");

document.getElementById("todayDate").textContent =
    new Date().toLocaleDateString("en-US", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric"
    });

document.getElementById("attDate").value = today;

document.getElementById("reportMonth").value =
    today.slice(0, 7);

function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[char]);
}

function getEmployee(id) {
    return employees.find(emp => emp.id === id);
}

function photoURL(url) {
    const safe = String(url || "");

    if (/^https?:\/\//i.test(safe)) {
        return escapeHTML(safe);
    }

    return "https://i.pravatar.cc/150?img=12";
}

function statusBadge(status) {
    const classes = {
        Present: "present",
        Absent: "absent",
        Late: "late",
        Approved: "approved",
        Rejected: "rejected",
        Pending: "pending"
    };

    return `<span class="status ${classes[status] || "pending"}">
        ${escapeHTML(status)}
    </span>`;
}

/* ==========================
   NAVIGATION
========================== */

function showSection(section, element) {

    document.querySelectorAll(".section")
        .forEach(s => s.classList.remove("active"));

    document.querySelectorAll(".nav-link")
        .forEach(n => n.classList.remove("active"));

    document.getElementById(section)
        .classList.add("active");

    if (element) {
        element.classList.add("active");
    } else {
        document.querySelectorAll(".nav-link").forEach(link => {
            if (link.getAttribute("onclick")?.includes(
                "'" + section + "'")) {
                link.classList.add("active");
            }
        });
    }

    const titles = {
        dashboard: "Dashboard Overview",
        employees: "Employee Directory",
        attendance: "Attendance Management",
        leaves: "Leave Management",
        reports: "Monthly Reports"
    };

    document.getElementById("pageTitle").textContent =
        titles[section];

    refreshAll();
}

/* ==========================
   EMPLOYEE MANAGEMENT
========================== */

function renderEmployees() {

    const search = document.getElementById(
        "employeeSearch").value.toLowerCase();

    const filtered = employees.filter(emp =>
        [emp.name, emp.id, emp.department, emp.position]
            .some(value => String(value).toLowerCase()
                .includes(search))
    );

    document.getElementById("employeeTable").innerHTML =
        filtered.map(emp => `
        <tr>
            <td>
                <div class="employee-cell">
                    <img src="${photoURL(emp.photo)}"
                         onerror="this.src='https://i.pravatar.cc/150?img=12'">
                    <div>
                        <b>${escapeHTML(emp.name)}</b>
                        <small>${escapeHTML(emp.position)}</small>
                    </div>
                </div>
            </td>
            <td>${escapeHTML(emp.id)}</td>
            <td>${escapeHTML(emp.department)}</td>
            <td>${escapeHTML(emp.position)}</td>
            <td>${escapeHTML(emp.phone)}</td>
            <td>
                <div class="action-buttons">
                    <button class="btn btn-light"
                        onclick="editEmployee('${emp.id}')">
                        Edit
                    </button>
                    <button class="btn btn-danger"
                        onclick="deleteEmployee('${emp.id}')">
                        Delete
                    </button>
                </div>
            </td>
        </tr>
        `).join("") || `
        <tr><td colspan="6" class="empty">
            No employees found.
        </td></tr>`;
}

function openEmployeeModal() {

    document.getElementById("modalTitle").textContent =
        "Add New Employee";

    document.getElementById("editEmployeeId").value = "";
    document.getElementById("empName").value = "";
    document.getElementById("empPosition").value = "";
    document.getElementById("empPhone").value = "";
    document.getElementById("empPhoto").value = "";

    document.getElementById("employeeModal")
        .classList.add("show");
}

function closeEmployeeModal() {
    document.getElementById("employeeModal")
        .classList.remove("show");
}

function saveEmployee() {

    const name = document.getElementById("empName")
        .value.trim();

    const department = document.getElementById("empDepartment")
        .value;

    const position = document.getElementById("empPosition")
        .value.trim();

    const phone = document.getElementById("empPhone")
        .value.trim();

    const photo = document.getElementById("empPhoto")
        .value.trim();

    const editId = document.getElementById("editEmployeeId")
        .value;

    if (!name || !position || !phone) {
        alert("Please fill in all required fields.");
        return;
    }

    if (editId) {

        const emp = getEmployee(editId);

        if (!emp) return;

        Object.assign(emp, {
            name, department, position, phone,
            photo: photo || emp.photo
        });

    } else {

        const newId = "EMP" +
            String(Date.now()).slice(-6);

        employees.push({
            id: newId,
            name,
            department,
            position,
            phone,
            photo: photo || "https://i.pravatar.cc/150?img=12"
        });
    }

    saveData();
    closeEmployeeModal();
    refreshAll();

    alert(editId
        ? "Employee information updated."
        : "New employee added successfully.");
}

function editEmployee(id) {

    const emp = getEmployee(id);

    if (!emp) return;

    document.getElementById("modalTitle").textContent =
        "Edit Employee";

    document.getElementById("editEmployeeId").value = emp.id;
    document.getElementById("empName").value = emp.name;
    document.getElementById("empDepartment").value =
        emp.department;
    document.getElementById("empPosition").value =
        emp.position;
    document.getElementById("empPhone").value = emp.phone;
    document.getElementById("empPhoto").value = emp.photo;

    document.getElementById("employeeModal")
        .classList.add("show");
}

function deleteEmployee(id) {

    if (!confirm("Are you sure you want to delete this employee?")) {
        return;
    }

    employees = employees.filter(emp => emp.id !== id);

    saveData();
    refreshAll();
}

/* ==========================
   EMPLOYEE SELECT OPTIONS
========================== */

function renderSelectOptions() {

    const options = employees.map(emp =>
        `<option value="${emp.id}">
            ${escapeHTML(emp.name)} (${emp.id})
        </option>`
    ).join("");

    document.getElementById("attEmployee").innerHTML =
        options;

    document.getElementById("leaveEmployee").innerHTML =
        options;
}

/* ==========================
   ATTENDANCE MANAGEMENT
========================== */

function saveAttendance() {

    const employeeId = document.getElementById(
        "attEmployee").value;

    const date = document.getElementById("attDate").value;
    const checkIn = document.getElementById("checkIn").value;
    const checkOut = document.getElementById("checkOut").value;
    const status = document.getElementById("attStatus").value;

    if (!employeeId || !date) {
        alert("Please select an employee and date.");
        return;
    }

    if (checkIn && checkOut && checkOut <= checkIn) {
        alert("Check-out time must be later than check-in.");
        return;
    }

    const existing = attendance.find(item =>
        item.employeeId === employeeId &&
        item.date === date
    );

    if (existing) {

        Object.assign(existing, {
            checkIn: status === "Absent" ? "-" : (checkIn || "-"),
            checkOut: status === "Absent" ? "-" : (checkOut || "-"),
            status
        });

    } else {

        attendance.push({
            employeeId,
            date,
            checkIn: status === "Absent" ? "-" : (checkIn || "-"),
            checkOut: status === "Absent" ? "-" : (checkOut || "-"),
            status
        });
    }

    saveData();
    refreshAll();

    alert("Attendance saved successfully.");
}

function renderAttendance() {

    const rows = [...attendance].sort((a,b) =>
        b.date.localeCompare(a.date));

    document.getElementById("attendanceTable").innerHTML =
        rows.map(item => {

            const emp = getEmployee(item.employeeId);

            if (!emp) return "";

            return `
            <tr>
                <td>${escapeHTML(emp.name)}</td>
                <td>${escapeHTML(item.date)}</td>
                <td>${escapeHTML(item.checkIn)}</td>
                <td>${escapeHTML(item.checkOut)}</td>
                <td>${statusBadge(item.status)}</td>
            </tr>`;
        }).join("") || `
        <tr><td colspan="5" class="empty">
            No attendance records yet.
        </td></tr>`;
}

/* ==========================
   LEAVE MANAGEMENT
========================== */

function submitLeave() {

    const employeeId = document.getElementById(
        "leaveEmployee").value;

    const type = document.getElementById("leaveType").value;
    const start = document.getElementById("leaveStart").value;
    const end = document.getElementById("leaveEnd").value;
    const reason = document.getElementById("leaveReason")
        .value.trim();

    if (!employeeId || !start || !end || !reason) {
        alert("Please complete the leave application.");
        return;
    }

    if (end < start) {
        alert("End date cannot be before start date.");
        return;
    }

    leaves.push({
        id: Date.now(),
        employeeId,
        type,
        start,
        end,
        reason,
        status: "Pending"
    });

    saveData();

    document.getElementById("leaveReason").value = "";
    document.getElementById("leaveStart").value = "";
    document.getElementById("leaveEnd").value = "";

    refreshAll();

    alert("Leave application submitted successfully.");
}

function updateLeave(id, status) {

    const leave = leaves.find(item =>
        item.id === id);

    if (!leave || leave.status !== "Pending") return;

    leave.status = status;

    saveData();
    refreshAll();

    alert("Leave request " + status.toLowerCase() + ".");
}

function renderLeaves() {

    document.getElementById("leaveTable").innerHTML =
        leaves.map(item => {

            const emp = getEmployee(item.employeeId);

            if (!emp) return "";

            return `
            <tr>
                <td>${escapeHTML(emp.name)}</td>
                <td>${escapeHTML(item.type)}</td>
                <td>
                    ${escapeHTML(item.start)}
                    <br>to ${escapeHTML(item.end)}
                </td>
                <td>${escapeHTML(item.reason)}</td>
                <td>${statusBadge(item.status)}</td>
                <td>
                    ${item.status === "Pending" ? `
                    <div class="action-buttons">
                        <button class="btn btn-success"
                            onclick="updateLeave(${item.id},'Approved')">
                            Approve
                        </button>
                        <button class="btn btn-danger"
                            onclick="updateLeave(${item.id},'Rejected')">
                            Reject
                        </button>
                    </div>` : "-"}
                </td>
            </tr>`;
        }).join("") || `
        <tr><td colspan="6" class="empty">
            No leave applications found.
        </td></tr>`;
}

/* ==========================
   DASHBOARD
========================== */

function renderDashboard() {

    const todayRecords = attendance.filter(item =>
        item.date === today);

    const present = todayRecords.filter(item =>
        item.status === "Present").length;

    const absent = todayRecords.filter(item =>
        item.status === "Absent").length;

    const late = todayRecords.filter(item =>
        item.status === "Late").length;

    document.getElementById("totalEmployees").textContent =
        employees.length;

    document.getElementById("presentCount").textContent =
        present;

    document.getElementById("absentCount").textContent =
        absent;

    document.getElementById("pendingCount").textContent =
        leaves.filter(item =>
            item.status === "Pending").length;

    const total = Math.max(employees.length, 1);

    document.getElementById("presentBar").style.width =
        (present / total * 100) + "%";

    document.getElementById("absentBar").style.width =
        (absent / total * 100) + "%";

    document.getElementById("lateBar").style.width =
        (late / total * 100) + "%";

    document.getElementById("recentAttendance").innerHTML =
        todayRecords.slice(0, 7).map(item => {

            const emp = getEmployee(item.employeeId);

            if (!emp) return "";

            return `
            <tr>
                <td>
                    <div class="employee-cell">
                        <img src="${photoURL(emp.photo)}">
                        <b>${escapeHTML(emp.name)}</b>
                    </div>
                </td>
                <td>${escapeHTML(item.checkIn)}</td>
                <td>${statusBadge(item.status)}</td>
            </tr>`;
        }).join("") || `
        <tr><td colspan="3" class="empty">
            No attendance marked for today.
        </td></tr>`;
}

/* ==========================
   MONTHLY REPORTS
========================== */

function renderReports() {

    const month = document.getElementById(
        "reportMonth").value;

    if (!month) return;

    const records = attendance.filter(item =>
        item.date.startsWith(month));

    const present = records.filter(item =>
        item.status === "Present").length;

    const absent = records.filter(item =>
        item.status === "Absent").length;

    const late = records.filter(item =>
        item.status === "Late").length;

    document.getElementById("reportTotal").textContent =
        records.length;

    document.getElementById("reportPresent").textContent =
        present;

    document.getElementById("reportAbsent").textContent =
        absent;

    document.getElementById("reportLate").textContent =
        late;

    document.getElementById("reportTable").innerHTML =
        employees.map(emp => {

            const own = records.filter(item =>
                item.employeeId === emp.id);

            const p = own.filter(item =>
                item.status === "Present").length;

            const a = own.filter(item =>
                item.status === "Absent").length;

            const l = own.filter(item =>
                item.status === "Late").length;

            const rate = own.length
                ? Math.round((p + l) / own.length * 100)
                : 0;

            return `
            <tr>
                <td>${escapeHTML(emp.name)}</td>
                <td>${p}</td>
                <td>${a}</td>
                <td>${l}</td>
                <td>
                    ${rate}%
                    <div class="progress">
                        <div style="width:${rate}%"></div>
                    </div>
                </td>
            </tr>`;
        }).join("");
}

/* ==========================
   CSV EXPORT
========================== */

function downloadCSV() {

    const month = document.getElementById(
        "reportMonth").value;

    if (!month) {
        alert("Please select a month.");
        return;
    }

    const records = attendance.filter(item =>
        item.date.startsWith(month));

    const rows = [
        ["Employee ID", "Employee Name", "Date",
         "Check In", "Check Out", "Status"]
    ];

    records.forEach(item => {

        const emp = getEmployee(item.employeeId);

        if (!emp) return;

        rows.push([
            emp.id,
            emp.name,
            item.date,
            item.checkIn,
            item.checkOut,
            item.status
        ]);
    });

    const csv = rows.map(row =>
        row.map(value =>
            '"' + String(value).replace(/"/g, '""') + '"'
        ).join(",")
    ).join("\r\n");

    const blob = new Blob(
        ["\uFEFF" + csv],
        { type: "text/csv;charset=utf-8;" }
    );

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "StaffDesk_Attendance_" +
        month + ".csv";

    link.click();

    URL.revokeObjectURL(url);
}

/* ==========================
   REFRESH ALL SECTIONS
========================== */

function refreshAll() {

    renderSelectOptions();
    renderEmployees();
    renderAttendance();
    renderLeaves();
    renderDashboard();
    renderReports();
}

refreshAll();

</script>

